# Copy to .env and fill in locally. Never commit .env.

# Required for PaperQA2 corpus Q&A and optional LLM enrichment of paper notes.
# Discovery (OpenAlex, PubMed, bioRxiv/medRxiv, Unpaywall) does not need this key.
OPENAI_API_KEY=

# Optional model override used when the OpenAI key is present.
OPENAI_MODEL=gpt-4o-mini

# SQLite v1 default. For Postgres:
# DATABASE_URL=postgresql+psycopg://litdb:litdb@localhost:5432/litdb
DATABASE_URL=sqlite:///./data/litdb.sqlite3

# Contact email sent to OpenAlex and Unpaywall (polite pool). Use a lab address.
CONTACT_EMAIL=lab@example.com

# Optional token to protect POST /api/ingest on a deployed host.
INGEST_TOKEN=

# Where OA PDFs and the SQLite file live.
DATA_DIR=./data
